# Settings for the deploy and validate scripts in scripts/.
# Copy this file to .env (gitignored) and fill in your values.

# ── Grafana ───────────────────────────────────────────────────────────────────
# GRAFANA_URL   — your stack URL (e.g. https://your-org.grafana.net)
# GRAFANA_TOKEN — a Grafana service account token with the Editor role
#                 (Administration → Users and access → Service accounts)

GRAFANA_URL=https://your-org.grafana.net
GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: exact datasource *names* to use instead of auto-detection.
# Auto-detection prefers Grafana Cloud's primary datasources (uid grafanacloud-prom /
# grafanacloud-logs); set these if you have several and want a different one.
# GRAFANA_PROM_DS=grafanacloud-<stack>-prom
# GRAFANA_LOKI_DS=grafanacloud-<stack>-logs

# ── Compliance window ─────────────────────────────────────────────────────────
# Lookback used by the Loki recording rules and by the ComplianceScanStale alert.
# It must be longer than the longest interval between two scans of the same profile
# on a host. The default suits the shipped schedule (linux-baseline hourly,
# cis-dil-benchmark every 6 h); use 26h if you scan once a day.
# COMPLIANCE_WINDOW=13h

# Optional: only deploy per-control recording rules for the profiles you scan.
# COMPLIANCE_PROFILES="linux-baseline cis-dil-benchmark"

# The Alloy credentials for each host (PROM_*/LOKI_* URL, username, password) are not
# used by these scripts. Set them in ansible/group_vars/all/vars.yml, or in
# /etc/default/alloy for a manual install (see docs/setup.md).
