# Grafana Cloud credentials for all deploy-*.sh scripts
# Copy this file to .env (which is gitignored) and fill in your values.
#
# Find these at: Grafana Cloud → Your Stack → Grafana Data Sources
#   GRAFANA_URL  — your stack URL (e.g. https://your-org.grafana.net)
#   GRAFANA_TOKEN — a Grafana service account token with Editor role

GRAFANA_URL=https://your-org.grafana.net
GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: specify exact datasource names to avoid auto-detection.
# Useful if you have multiple Prometheus or Loki sources in your stack.
# GRAFANA_PROM_DS=grafana-cloud-prom
# GRAFANA_LOKI_DS=grafana-cloud-logs
