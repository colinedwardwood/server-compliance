# Credentials for this project.
# Copy this file to .env (which is gitignored) and fill in your values.

# ── Grafana Cloud ─────────────────────────────────────────────────────────────
# Used by: scripts/deploy-*.sh and scripts/validate-grafana.sh
#
# GRAFANA_URL   — your stack URL (e.g. https://your-org.grafana.net)
# GRAFANA_TOKEN — a Grafana service account token with Editor role
#                 (Grafana Cloud → Administration → Service accounts)

GRAFANA_URL=https://your-org.grafana.net
GRAFANA_TOKEN=glsa_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: specify exact datasource names to avoid auto-detection.
# Useful if you have multiple Prometheus or Loki sources in your stack.
# GRAFANA_PROM_DS=grafana-cloud-prom
# GRAFANA_LOKI_DS=grafana-cloud-logs

# ── Loki (for Grafana Alloy on the host) ──────────────────────────────────────
# Used by: Ansible (group_vars/all/vars.yml) and config.alloy on each host.
# Not consumed by the deploy scripts.
#
# LOKI_URL      — Loki push endpoint   (Grafana Cloud → Data Sources → Loki → Connection)
# LOKI_USERNAME — Loki user ID / tenant (numeric, shown in Data Sources)
# LOKI_API_KEY  — Loki API key with MetricsPublisher role
#                 (Grafana Cloud → Administration → Service accounts)

LOKI_URL=https://logs-prod-XXX.grafana.net
LOKI_USERNAME=000000
LOKI_API_KEY=glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
