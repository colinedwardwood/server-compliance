# group_vars/all/vars.yml — copy to vars.yml and fill in your values.
# Commit vars.yml only after encrypting with: ansible-vault encrypt vars.yml
#
# Find credentials at:
#   Grafana Cloud → Your Stack → Details → Grafana Data Sources → Prometheus / Loki
#   (username is the numeric instance ID; password is a cloud access token)

grafana_prom_username: "123456"
grafana_prom_password: "glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
grafana_loki_username: "789012"
grafana_loki_password: "glc_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Override endpoints only if your stack is in a different region:
# grafana_prom_url: "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push"
# grafana_loki_url: "https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push"

# Override profile storage location if needed (defaults to /opt/audit-profiles):
# audit_profiles_base: "/opt/audit-profiles"
