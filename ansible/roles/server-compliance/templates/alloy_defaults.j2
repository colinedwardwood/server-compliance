# /etc/default/alloy
# Grafana Alloy environment variables — managed by Ansible.
# Credentials are loaded by config.alloy via env("VAR_NAME").
# This file is mode 0600; do not share or commit with real values.

PROM_USERNAME={{ grafana_prom_username }}
PROM_PASSWORD={{ grafana_prom_password }}
LOKI_USERNAME={{ grafana_loki_username }}
LOKI_PASSWORD={{ grafana_loki_password }}
